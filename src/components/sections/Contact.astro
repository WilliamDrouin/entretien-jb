---
const hours = [
  { day: 'Lun – Ven', time: '7h00 à 18h00' },
  { day: 'Samedi',    time: '8h00 à 14h00' },
  { day: 'Dimanche',  time: 'Fermé' },
];

const services = [
  'Tonte de gazon',
  'Nettoyage de terrain',
  'Débroussaillage',
  'Déneigement résidentiel',
  'Déneigement commercial',
  'Autre / Plusieurs services',
];
---

<section id="contact" class="section-padding relative overflow-hidden" style="background:#fafaf7;">
  <!-- Top green wave from previous section -->
  <div class="absolute top-0 left-0 right-0" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="w-full h-10 md:h-14" fill="white">
      <path d="M0,30 C360,60 720,0 1080,30 C1260,45 1360,15 1440,30 L1440,0 L0,0 Z"/>
    </svg>
  </div>

  <!-- Green corner accent -->
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full opacity-[0.05] pointer-events-none"
    style="background: radial-gradient(circle, #16a34a 0%, transparent 70%); transform: translate(30%, -30%);"
    aria-hidden="true"
  ></div>

  <div class="container-custom relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#16a34a]/10 text-[#16a34a] text-xs font-bold uppercase tracking-wider mb-5">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Soumission gratuite
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4 leading-tight">
        Obtenez votre<br/>
        <span class="text-[#16a34a]">soumission gratuite</span>
      </h2>
      <p class="text-slate-500 text-lg leading-relaxed">
        Remplissez le formulaire et nous vous répondons en moins de 24h —
        sans engagement, sans frais.
      </p>
    </div>

    <!-- Content: form + info -->
    <div class="grid lg:grid-cols-5 gap-8 xl:gap-12">

      <!-- Form (3/5) -->
      <div class="lg:col-span-3 reveal" data-delay="100">
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-7 md:p-9">
          <form
            id="contact-form"
            class="space-y-5"
            novalidate
            aria-label="Formulaire de soumission"
          >
            <!-- Name + Email row -->
            <div class="grid sm:grid-cols-2 gap-5">
              <div class="form-group">
                <label for="nom" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Nom complet <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="nom"
                  name="nom"
                  autocomplete="name"
                  required
                  placeholder="Jean Tremblay"
                  class="form-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 text-sm transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#16a34a]/25 focus:border-[#16a34a]"
                />
              </div>
              <div class="form-group">
                <label for="courriel" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Courriel <span class="text-red-400">*</span>
                </label>
                <input
                  type="email"
                  id="courriel"
                  name="courriel"
                  autocomplete="email"
                  required
                  placeholder="jean@exemple.com"
                  class="form-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 text-sm transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#16a34a]/25 focus:border-[#16a34a]"
                />
              </div>
            </div>

            <!-- Phone + Service row -->
            <div class="grid sm:grid-cols-2 gap-5">
              <div class="form-group">
                <label for="telephone" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Téléphone
                </label>
                <input
                  type="tel"
                  id="telephone"
                  name="telephone"
                  autocomplete="tel"
                  placeholder="(418) 555-0000"
                  class="form-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 text-sm transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#16a34a]/25 focus:border-[#16a34a]"
                />
              </div>
              <div class="form-group">
                <label for="service" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Service souhaité <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                  <select
                    id="service"
                    name="service"
                    required
                    class="form-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 text-sm appearance-none cursor-pointer transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#16a34a]/25 focus:border-[#16a34a]"
                  >
                    <option value="" disabled selected>Choisir un service…</option>
                    {services.map((s) => <option value={s}>{s}</option>)}
                  </select>
                  <div class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>

            <!-- Message -->
            <div class="form-group">
              <label for="message" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Votre message <span class="text-red-400">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                placeholder="Décrivez votre propriété, la superficie approximative, vos besoins ou toute information utile…"
                class="form-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 text-sm resize-none transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#16a34a]/25 focus:border-[#16a34a]"
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="pt-1">
              <button
                type="submit"
                id="submit-btn"
                class="group w-full flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl bg-[#16a34a] text-white font-bold text-base hover:bg-[#15803d] active:scale-[0.98] transition-all duration-200 shadow-md shadow-green-900/15 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span id="btn-label">Envoyer ma demande</span>
                <svg id="btn-arrow" class="transition-transform group-hover:translate-x-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
                <svg id="btn-spinner" class="hidden animate-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
              </button>
            </div>

            <!-- Error summary -->
            <div id="form-error" class="hidden flex items-start gap-2.5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm">
              <svg class="flex-shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <span id="form-error-text">Veuillez remplir tous les champs obligatoires.</span>
            </div>

            <!-- Success -->
            <div id="form-success" class="hidden flex items-start gap-2.5 p-4 rounded-xl bg-[#16a34a]/10 border border-[#16a34a]/25 text-[#15803d] text-sm">
              <svg class="flex-shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <div>
                <strong class="block mb-0.5">Demande envoyée!</strong>
                Nous vous répondrons dans les prochaines 24h. Merci de votre confiance!
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Info card (2/5) -->
      <div class="lg:col-span-2 flex flex-col gap-6 reveal" data-delay="200" data-from="right">

        <!-- Contact details -->
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-7">
          <h3 class="font-bold text-slate-900 mb-5 flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            Coordonnées
          </h3>
          <div class="space-y-4">
            <a href="tel:+14185550000" class="group flex items-center gap-3 text-slate-600 hover:text-[#16a34a] transition-colors">
              <div class="w-9 h-9 rounded-lg bg-[#16a34a]/8 flex items-center justify-center flex-shrink-0">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.08 6.08l1.09-.94a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 font-medium">Téléphone</p>
                <p class="text-sm font-semibold text-slate-700 group-hover:text-[#16a34a] transition-colors">(418) XXX-XXXX</p>
              </div>
            </a>

            <a href="mailto:info@entretienjb.ca" class="group flex items-center gap-3 text-slate-600 hover:text-[#16a34a] transition-colors">
              <div class="w-9 h-9 rounded-lg bg-[#16a34a]/8 flex items-center justify-center flex-shrink-0">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 font-medium">Courriel</p>
                <p class="text-sm font-semibold text-slate-700 group-hover:text-[#16a34a] transition-colors">info@entretienjb.ca</p>
              </div>
            </a>

            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-[#16a34a]/8 flex items-center justify-center flex-shrink-0">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 font-medium">Adresse</p>
                <p class="text-sm font-semibold text-slate-700">Saint-Georges-de-Beauce, QC</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Hours -->
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-7">
          <h3 class="font-bold text-slate-900 mb-5 flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            Heures d'ouverture
          </h3>
          <div class="space-y-2.5">
            {hours.map((h) => (
              <div class="flex items-center justify-between py-2 border-b border-slate-50 last:border-0">
                <span class="text-slate-600 text-sm font-medium">{h.day}</span>
                <span
                  class={`text-sm font-semibold ${h.time === 'Fermé' ? 'text-slate-400' : 'text-slate-900'}`}
                >
                  {h.time}
                </span>
              </div>
            ))}
          </div>
          <!-- Winter emergency note -->
          <div class="mt-4 flex items-start gap-2 p-3 rounded-xl bg-[#0ea5e9]/8 border border-[#0ea5e9]/20">
            <svg class="flex-shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12h20"/><path d="M12 2v20"/><path d="m4.93 4.93 14.14 14.14"/><path d="m19.07 4.93-14.14 14.14"/>
            </svg>
            <p class="text-slate-600 text-xs leading-relaxed">
              <strong class="text-slate-800">Déneigement:</strong> disponible 7j/7 selon les conditions hivernales.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .form-input:invalid:not(:placeholder-shown) {
    border-color: #fca5a5;
  }
  .form-input:valid:not(:placeholder-shown) {
    border-color: #86efac;
  }
</style>

<script>
  /* Form handling */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnLabel = document.getElementById('btn-label');
  const btnArrow = document.getElementById('btn-arrow');
  const btnSpinner = document.getElementById('btn-spinner');
  const errorBox = document.getElementById('form-error');
  const errorText = document.getElementById('form-error-text');
  const successBox = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nom = (document.getElementById('nom') as HTMLInputElement).value.trim();
    const courriel = (document.getElementById('courriel') as HTMLInputElement).value.trim();
    const service = (document.getElementById('service') as HTMLSelectElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    // Basic validation
    if (!nom || !courriel || !service || !message) {
      errorBox?.classList.remove('hidden');
      if (errorText) errorText.textContent = 'Veuillez remplir tous les champs obligatoires.';
      return;
    }
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRe.test(courriel)) {
      errorBox?.classList.remove('hidden');
      if (errorText) errorText.textContent = 'Veuillez entrer une adresse courriel valide.';
      return;
    }

    errorBox?.classList.add('hidden');

    // Loading state
    if (submitBtn) submitBtn.disabled = true;
    btnLabel && (btnLabel.textContent = 'Envoi en cours…');
    btnArrow?.classList.add('hidden');
    btnSpinner?.classList.remove('hidden');

    // Simulate submission (replace with real fetch/API call)
    await new Promise((r) => setTimeout(r, 1200));

    // Success state
    if (submitBtn) submitBtn.disabled = false;
    btnLabel && (btnLabel.textContent = 'Envoyer ma demande');
    btnArrow?.classList.remove('hidden');
    btnSpinner?.classList.add('hidden');
    successBox?.classList.remove('hidden');
    form.reset();

    // Scroll success into view
    successBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
