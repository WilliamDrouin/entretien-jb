---
type Service = {
  id: string;
  title: string;
  description: string;
  season: string;
  accentColor: string;
  lightBg: string;
  iconPath: string;
  delay: number;
};

const services: Service[] = [
  {
    id: 'tonte',
    title: 'Tonte de gazon',
    description:
      'Un gazon impeccable à chaque visite. Taille précise, ramassage des rognures et finition soignée pour une pelouse saine et esthétique toute la saison.',
    season: 'Printemps · Été · Automne',
    accentColor: '#16a34a',
    lightBg: 'rgba(22,163,74,0.09)',
    iconPath:
      '<circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="M20 4 8.12 15.88"/><path d="m14.47 14.48 5.53 5.52"/><path d="M8.12 8.12 12 12"/>',
    delay: 100,
  },
  {
    id: 'nettoyage',
    title: 'Nettoyage de terrain',
    description:
      "Ramassage de feuilles, débris et résidus hivernaux au printemps comme à l'automne. Votre propriété toujours présentable, saison après saison.",
    season: 'Printemps · Automne',
    accentColor: '#d97706',
    lightBg: 'rgba(217,119,6,0.09)',
    iconPath:
      '<path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.4A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/>',
    delay: 200,
  },
  {
    id: 'debroussaillage',
    title: 'Débroussaillage',
    description:
      'Élimination des mauvaises herbes, arbustes envahissants et végétation indésirable. Reprenez le contrôle de votre espace extérieur durablement.',
    season: 'Printemps · Été · Automne',
    accentColor: '#059669',
    lightBg: 'rgba(5,150,105,0.09)',
    iconPath:
      '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
    delay: 300,
  },
  {
    id: 'deneigement',
    title: 'Déneigement',
    description:
      'Service résidentiel et commercial rapide et fiable après chaque chute de neige. Entrées, stationnements et trottoirs dégagés pour votre sécurité.',
    season: 'Hiver',
    accentColor: '#0ea5e9',
    lightBg: 'rgba(14,165,233,0.09)',
    iconPath:
      '<path d="M2 12h20"/><path d="M12 2v20"/><path d="m4.93 4.93 14.14 14.14"/><path d="m19.07 4.93-14.14 14.14"/>',
    delay: 400,
  },
];
---

<section id="services" class="section-padding relative overflow-hidden" style="background: #fafaf7;">
  <!-- Subtle dot grid background -->
  <div
    class="absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(circle, #16a34a 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  ></div>

  <!-- Decorative corner accent -->
  <div
    class="absolute top-0 right-0 w-[480px] h-[480px] rounded-full opacity-[0.04] pointer-events-none"
    style="background: radial-gradient(circle, #16a34a 0%, transparent 70%); transform: translate(30%, -40%);"
    aria-hidden="true"
  ></div>

  <div class="container-custom relative z-10">

    <!-- Section header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#16a34a]/10 text-[#16a34a] text-xs font-bold uppercase tracking-wider mb-5">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6"/>
        </svg>
        Nos services
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4 leading-tight">
        Des services adaptés à<br/>
        <span class="text-[#16a34a]">chaque saison</span>
      </h2>
      <p class="text-slate-500 text-lg leading-relaxed">
        De la première tonte au déneigement hivernal, nous prenons soin de votre propriété
        toute l'année — rapidement, proprement, au bon prix.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
      {services.map((service) => (
        <article
          class="service-card reveal group relative bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden cursor-default"
          data-delay={`${service.delay}`}
        >
          <!-- Top accent bar (slides in on hover) -->
          <div
            class="absolute top-0 left-0 right-0 h-[3px] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out"
            style={`background: ${service.accentColor}`}
            aria-hidden="true"
          ></div>

          <div class="p-7 md:p-8">
            <!-- Icon + season row -->
            <div class="flex items-start justify-between gap-4 mb-6">
              <div
                class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110"
                style={`background: ${service.lightBg}`}
              >
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke={service.accentColor}
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={service.iconPath}
                />
              </div>

              <span
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-semibold leading-none whitespace-nowrap mt-1"
                style={`background: ${service.lightBg}; color: ${service.accentColor}`}
              >
                <span
                  class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                  style={`background: ${service.accentColor}`}
                ></span>
                {service.season}
              </span>
            </div>

            <!-- Title -->
            <h3
              class="text-xl font-bold text-slate-900 mb-3 transition-colors duration-200 group-hover:text-slate-800"
            >
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-slate-500 text-[0.94rem] leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- CTA link -->
            <a
              href="#contact"
              class="inline-flex items-center gap-1.5 text-sm font-semibold transition-all duration-200"
              style={`color: ${service.accentColor}`}
              aria-label={`En savoir plus sur ${service.title}`}
            >
              En savoir plus
              <svg
                class="transition-transform duration-200 group-hover:translate-x-1"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-14 reveal" data-delay="500">
      <p class="text-slate-400 text-sm mb-5">
        Toutes les soumissions sont gratuites et sans engagement
      </p>
      <a
        href="#contact"
        class="group inline-flex items-center gap-2.5 px-8 py-4 rounded-xl bg-[#16a34a] text-white font-bold text-base hover:bg-[#15803d] active:scale-[0.98] transition-all duration-200 shadow-md shadow-green-900/15"
      >
        Demander une soumission gratuite
        <svg
          class="transition-transform duration-200 group-hover:translate-x-0.5"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Hover uses CSS `translate` to avoid conflict with Motion's `transform` */
  .service-card {
    transition: translate 0.25s ease, box-shadow 0.25s ease;
  }
  .service-card:hover {
    translate: 0 -5px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.07), 0 8px 16px rgba(0, 0, 0, 0.04);
  }
</style>
