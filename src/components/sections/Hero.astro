---
---
<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
>
  <!-- Background photo -->
  <div class="absolute inset-0">
    <img
      src="/terrainresidentiel.jpg"
      alt=""
      class="w-full h-full object-cover object-center"
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Dark green overlay for text readability -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(145deg, rgba(14,53,29,0.90) 0%, rgba(21,128,61,0.80) 50%, rgba(12,110,138,0.85) 100%);"
    ></div>
  </div>

  <!-- Subtle dot-grid overlay -->
  <div
    class="absolute inset-0 opacity-[0.05]"
    style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 28px 28px;"
  ></div>

  <!-- Main content -->
  <div class="container-custom relative z-10 pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="max-w-4xl">

      <!-- Location badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-white/25 bg-white/10 backdrop-blur-sm mb-7 hero-fade-in" data-hero data-delay="0">
        <span class="w-2 h-2 rounded-full bg-green-300 animate-pulse flex-shrink-0"></span>
        <span class="text-white/90 text-sm font-medium">Saint-Georges, Beauce · Service 4 saisons</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.08] mb-6 hero-fade-in" data-hero data-delay="100">
        Votre expert en<br class="hidden sm:block"/>
        <span class="text-green-300">entretien extérieur</span>,<br/>
        4&nbsp;saisons
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed hero-fade-in" data-hero data-delay="200">
        Tonte de gazon, nettoyage de terrain, débroussaillage et déneigement —
        nous prenons soin de votre propriété tout au long de l'année.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-4 mb-14 hero-fade-in" data-hero data-delay="300">
        <a
          href="#contact"
          class="group inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl bg-white text-[#15803d] font-bold text-base hover:bg-green-50 active:scale-95 transition-all duration-200 shadow-lg shadow-black/20"
        >
          Demander une soumission
          <svg class="transition-transform duration-200 group-hover:translate-x-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="#services"
          class="group inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl border-2 border-white/40 text-white font-semibold text-base hover:bg-white/10 hover:border-white/60 active:scale-95 transition-all duration-200 backdrop-blur-sm"
        >
          Voir nos services
          <svg class="transition-transform duration-200 group-hover:translate-y-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12l7 7 7-7"/>
          </svg>
        </a>
      </div>

      <!-- Trust badges -->
      <div class="flex flex-wrap gap-x-8 gap-y-3 hero-fade-in" data-hero data-delay="420">
        <div class="flex items-center gap-2.5 text-white/70">
          <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <span class="text-sm font-medium">Saint-Georges Beauce</span>
        </div>

        <div class="flex items-center gap-2.5 text-white/70">
          <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <span class="text-sm font-medium">Service rapide</span>
        </div>

        <div class="flex items-center gap-2.5 text-white/70">
          <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <span class="text-sm font-medium">+10 ans d'expérience</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 text-white/40 scroll-bounce" aria-hidden="true">
    <span class="text-xs font-medium tracking-widest uppercase">Défiler</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>

  <!-- Bottom wave transition to cream -->
  <div class="absolute bottom-0 left-0 right-0 z-10" aria-hidden="true">
    <svg
      viewBox="0 0 1440 72"
      preserveAspectRatio="none"
      class="w-full h-12 md:h-16 lg:h-[72px]"
      fill="#fafaf7"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M0,36 C240,72 480,0 720,36 C960,72 1200,0 1440,36 L1440,72 L0,72 Z"/>
    </svg>
  </div>
</section>

<style>
  /* Initial hidden state — Motion animates these in */
  .hero-fade-in {
    opacity: 0;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0) translateX(-50%); opacity: 0.4; }
    50%       { transform: translateY(6px) translateX(-50%); opacity: 0.7; }
  }

  .scroll-bounce {
    animation: scrollBounce 2s ease-in-out infinite;
  }
</style>
