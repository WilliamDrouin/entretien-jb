---
const navLinks = [
  { href: '#services',     label: 'Services' },
  { href: '#about',        label: 'À propos' },
  { href: '#zone-service', label: 'Zone de service' },
  { href: '#testimonials', label: 'Témoignages' },
  { href: '#contact',      label: 'Contact' },
];

const serviceLinks = [
  { href: '#services', label: 'Tonte de gazon' },
  { href: '#services', label: 'Nettoyage de terrain' },
  { href: '#services', label: 'Débroussaillage' },
  { href: '#services', label: 'Déneigement résidentiel' },
  { href: '#services', label: 'Déneigement commercial' },
];
---

<footer class="bg-[#0d2218] text-white">
  <!-- Top wave -->
  <div aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="w-full h-10 md:h-14" fill="#fafaf7">
      <path d="M0,30 C240,60 480,0 720,30 C960,60 1200,0 1440,30 L1440,60 L0,60 Z"/>
    </svg>
  </div>

  <div class="container-custom py-14 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <!-- Logo -->
        <a href="#hero" class="inline-flex items-center gap-2.5 mb-4" aria-label="Entretien JB — Accueil">
          <div class="w-9 h-9 rounded-xl bg-[#16a34a] flex items-center justify-center flex-shrink-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22V12"/><path d="M5 12C5 7 8 3 12 2c4 1 7 5 7 10-3 0-5-1-7-3-2 2-4 3-7 3z"/>
            </svg>
          </div>
          <div class="leading-none">
            <span class="block font-bold text-[1.05rem] text-white">Entretien JB</span>
            <span class="block text-[0.65rem] text-white/50 font-medium tracking-wide uppercase">Saint-Georges Beauce</span>
          </div>
        </a>

        <p class="text-white/55 text-sm leading-relaxed mb-6 max-w-xs">
          Expert en entretien extérieur 4 saisons. Tonte, nettoyage, débroussaillage et
          déneigement — pour des propriétés impeccables toute l'année.
        </p>

        <!-- CTA -->
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#16a34a] text-white text-sm font-semibold hover:bg-[#15803d] transition-colors"
        >
          Soumission gratuite
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Navigation links -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-5">Navigation</h4>
        <ul class="space-y-2.5">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-white/55 text-sm hover:text-white transition-colors duration-150 flex items-center gap-1.5 group"
              >
                <span class="w-1 h-1 rounded-full bg-[#16a34a] opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services links -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-5">Services</h4>
        <ul class="space-y-2.5">
          {serviceLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-white/55 text-sm hover:text-white transition-colors duration-150 flex items-center gap-1.5 group"
              >
                <span class="w-1 h-1 rounded-full bg-[#16a34a] opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact info -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-5">Contact</h4>
        <div class="space-y-3.5">
          <a href="tel:+14185550000" class="flex items-center gap-3 text-white/55 text-sm hover:text-white transition-colors group">
            <div class="w-7 h-7 rounded-lg bg-white/8 flex items-center justify-center flex-shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.09 6.09l.94-1.09a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            (418) XXX-XXXX
          </a>

          <a href="mailto:info@entretienjb.ca" class="flex items-center gap-3 text-white/55 text-sm hover:text-white transition-colors group">
            <div class="w-7 h-7 rounded-lg bg-white/8 flex items-center justify-center flex-shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            info@entretienjb.ca
          </a>

          <div class="flex items-center gap-3 text-white/55 text-sm">
            <div class="w-7 h-7 rounded-lg bg-white/8 flex items-center justify-center flex-shrink-0">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            Saint-Georges-de-Beauce, QC
          </div>

          <!-- Hours summary -->
          <div class="mt-2 pt-4 border-t border-white/10">
            <p class="text-white/40 text-xs font-medium uppercase tracking-wider mb-2">Heures</p>
            <p class="text-white/55 text-xs leading-relaxed">
              Lun–Ven: 7h–18h · Sam: 8h–14h<br/>
              <span class="text-[#38bdf8]">Déneigement 7j/7 en hiver</span>
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/8">
    <div class="container-custom py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/35">
      <p>© {new Date().getFullYear()} Entretien JB. Tous droits réservés.</p>
      <p>
        Conçu par{' '}
        <a
          href="#"
          class="text-white/55 hover:text-white transition-colors font-medium"
          rel="noopener noreferrer"
        >
          PowerAi
        </a>
      </p>
    </div>
  </div>
</footer>
